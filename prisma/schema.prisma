// SchoolLedger — multi-tenant schema
//
// SECURITY NOTES (read before changing this file):
// - Every tenant-owned table carries an explicit organizationId column and an
//   index on it. ALL application queries must filter by organizationId — see
//   src/lib/tenant.ts, which is the only place allowed to build that filter.
// - No table stores a plaintext password. User.passwordHash is a bcrypt hash
//   only (see src/lib/auth.ts).
// - Money is stored as integer "cents" (amountCents) to avoid floating point
//   errors in financial calculations — never store money as Float.
// - AuditLog is append-only from the application's point of view: nothing in
//   this codebase should ever update or delete an AuditLog row.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN // full access: billing, settings, invite/remove users, all data
  ACCOUNTANT // record payments, manage children/categories, generate statements
  MANAGER // manage children/categories, cannot see money (see src/lib/permissions.ts)
  VIEWER // read-only, scope limited by ViewerScope
  TEACHER // Centre Management only, own assigned class only (assignedCategoryId)
  RECEPTIONIST // Centre Management only, can add children org-wide
}

// A specific, closed-set capability a member may or may not have. Roles
// (above) only decide the DEFAULT set of these (see
// src/lib/permissions.ts's ROLE_DEFAULT_PERMISSIONS) — the actual
// effective set for any one person is that default, adjusted by whatever
// MembershipPermission override rows exist for them. This is what lets an
// admin loosen/tighten one specific person's access without inventing a
// new role for them. ADMIN is special-cased in code to always have every
// permission, not stored/overridable as rows.
enum Permission {
  VIEW_CENTRE // can switch into Centre Management mode
  VIEW_ACCOUNTING // can switch into Accounting mode
  VIEW_MONEY // can see payment amounts, statements, financial totals
  RECORD_PAYMENTS // can record/edit payments
  MANAGE_CHILDREN // can add/edit/archive children (TEACHER: own assigned class only)
  MANAGE_CLASSES // can add/edit/archive classes
  MANAGE_EVENTS // can create one-time class-wide charges (events)
  SEND_REMINDERS // can mark reminders sent; combined with VIEW_MONEY, can run/approve "send all"
  REQUEST_DELETION // can request a category/child/payment be deleted
  APPROVE_DELETION // can approve a pending deletion request (2 needed) or restore from trash
  MANAGE_TEAM // can invite/remove members, change their role/permissions
  MANAGE_BILLING // can manage the org's own subscription
  MANAGE_SETTINGS // can edit org profile/letterhead and payment types
  VIEW_ACTIVITY_LOG // can view the audit/activity feed
  MANAGE_ATTENDANCE // can take/edit attendance and notify absent parents (TEACHER: own assigned class only)
  EXPORT_DATA // can download a full password-protected backup of the organization's data
  MANAGE_REPORTS // can create/edit/delete centre reports (incident/academic/disciplinary) (TEACHER: own assigned class only)
}

// The three Centre Management report kinds (Dylan, 1 Oct 2026 to-do: "we
// need to add a few more features, especially on the dashboard of center
// management reports... incident reports, academic reports, and behavior
// reports, call it disciplinary reports"). One model with a `type`
// discriminator, same approach as ChildDocument's `type` -- the three
// kinds share nearly every field (who, when, what happened, was the
// parent told), so three near-identical tables would only add
// duplication, not safety.
enum ReportType {
  INCIDENT
  ACADEMIC
  DISCIPLINARY
}

// A child's gender, for the Enrolled tile's gender breakdown chart
// (Phase 2 Session 2). Optional -- a school can leave it blank, same as
// ID numbers. Deliberately NOT the same category as ethnicity (dropped
// entirely, see docs/PLAN.md decision #5, over POPIA/legal caution) --
// gender wasn't flagged as needing that same check.
enum Gender {
  MALE
  FEMALE
  OTHER
}

// The 7 pre-built form templates (Phase 2 Session 3, see docs/PLAN.md
// decision #6) -- a fixed catalog defined in code (src/lib/forms/), not a
// user-editable list, per decision #8 (form builder approach, not
// arbitrary PDF editing/bring-your-own-PDF).
enum FormType {
  ENROLMENT
  RE_REGISTRATION
  INDEMNITY
  MEDICAL_ALLERGY
  PHOTO_MEDIA_CONSENT
  EMERGENCY_CONTACT_PICKUP
  FEE_AGREEMENT
}

enum PaymentMethod {
  CASH
  EFT
  CARD
  OTHER
}

enum PlanEntryStatus {
  UPCOMING
  OUTSTANDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DeletionTargetType {
  CATEGORY
  CHILD
  PAYMENT
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  CANCELLED
}

model Organization {
  id                String   @id @default(cuid())
  name              String
  countryCode       String // ISO 3166-1 alpha-2, drives currency + phone format
  currencyCode      String // ISO 4217, e.g. ZAR, USD
  addressLine1      String?
  addressLine2      String?
  province           String?
  logoUrl           String? // deprecated — superseded by logoImage (direct upload), kept so no column is dropped
  letterheadUrl     String? // deprecated — superseded by letterheadImage (direct upload), kept so no column is dropped
  // Uploaded images, stored as data: URLs (base64) directly in the row —
  // small enough (capped client- and server-side, see validation.ts) that
  // this avoids standing up separate blob storage/credentials for what is,
  // for a preschool's logo and letterhead, a handful of small images.
  logoImage         String?  @db.Text
  letterheadImage   String?  @db.Text
  contactName       String? // a real person to contact about the account (not necessarily an app user)
  contactEmail      String?
  contactPhone      String?
  bankName          String?
  // Never store full bank account numbers in plaintext beyond what's needed
  // to print on a statement. Kept optional and separate from anything else
  // sensitive so it can be encrypted-at-rest (see SECURITY.md) without a
  // schema change later (encryption handled at the field level in app code).
  bankAccountNumber String?
  timezone          String   @default("Africa/Johannesburg")
  // The org's chosen reminder message wording, with {{childName}} /
  // {{parentName}} / {{schoolName}} / {{amount}} placeholder tokens — see
  // src/lib/billing/reminderTemplates.ts, which owns the built-in options,
  // rendering, and the "must contain the 3 required placeholders" rule.
  // Null means "use the default built-in template" (REMINDER_TEMPLATES[0])
  // rather than duplicating that default text into the database.
  reminderMessageTemplate String? @db.Text
  // "Send all reminders" and automatic reminders (Dylan, 29 Sept 2026).
  // Emails go out from "<School> <slug@mail.crechely.co.za>" via Resend with
  // Reply-To set to the school (contactEmail, else an admin's email).
  // autoReminderDays: days of the month (1-28) the daily cron emails every
  // parent with an outstanding balance; empty or disabled = never.
  autoRemindersEnabled Boolean   @default(false)
  // Attach each family's PDF statement to reminder emails (on by default).
  attachStatementToReminders Boolean @default(true)
  autoReminderDays     Int[]     @default([])
  // Last time a bulk send ran (manual or automatic) -- a double-click guard.
  lastBulkReminderAt   DateTime?
  // "YYYY-MM-DD" (South African date) of the last automatic run, so a
  // retried cron never emails parents twice on the same day.
  lastAutoReminderOn   String?
  // Documents every child must have on file (Dylan, 30 Sept 2026) -- keys
  // from src/lib/documents.ts. Default: birth certificate, clinic card and
  // an ID for each parent/guardian.
  requiredDocuments    String[]  @default(["BIRTH_CERTIFICATE", "CLINIC_CARD", "GUARDIAN_ID"])
  paystackCustomerCode     String?  @unique
  paystackSubscriptionCode String?  @unique
  paystackPlanCode         String?
  // Only ever issued once, on the subscription.create webhook event, and
  // never retrievable again afterwards — required (alongside the
  // subscription code) to call Paystack's POST /subscription/disable when
  // an admin cancels from the app. See src/lib/paystack.ts.
  paystackEmailToken       String?
  // trialing | active | past_due | canceled | incomplete — a payment-
  // provider-agnostic vocabulary the app's own access checks key off of
  // (see src/lib/billing/access.ts). The Paystack webhook handler
  // translates Paystack's own event/status vocabulary into these values
  // (see src/app/api/webhooks/paystack/route.ts) rather than the app
  // adopting Paystack's vocabulary directly.
  subscriptionStatus String  @default("trialing")
  // Permanent public "apply to this school" link for NEW families (fix
  // session B, Dylan 23 Sept). Lookup is by hash; the token itself is kept
  // encrypted (src/lib/fieldCrypto.ts) so staff can copy the link again
  // from the Forms page. Regenerating replaces both and kills the old link.
  applyToken         String?
  applyTokenHash     String?  @unique
  currentPeriodEnd  DateTime?
  trialEndsAt       DateTime?
  // School deleted by its admin (28 Sept 2026). Set = in the 30-day trash:
  // nobody can use it, an admin can still restore it, and the daily purge
  // (src/lib/orgDeletion.ts) permanently removes it once 30 days pass.
  deletedAt         DateTime?
  deletedByUserId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  memberships   Membership[]
  invites       Invite[]
  categories    Category[]
  children      Child[]
  paymentTypes  PaymentType[]
  planEntries   FinancialPlanEntry[]
  payments      Payment[]
  creditBalances CreditBalance[]
  auditLogs     AuditLog[]
  events        Event[]
  deletionRequests DeletionRequest[]
  reminderSendRequests ReminderSendRequest[]
  guardians     Guardian[]
  formDocuments FormDocument[]
  parentFormLinks ParentFormLink[]
  parentSubmissions ParentSubmission[]
  attendanceRecords AttendanceRecord[]
  scheduleItems ClassScheduleItem[]
  whatsappGroupChecks WhatsAppGroupCheck[]
  subscriptionPayments SubscriptionPayment[]
  childDocuments       ChildDocument[]
  childReports         ChildReport[]
  dailySummaries       DailySummary[]
  lessonPlans          LessonPlan[]
  teacherTasks         TeacherTask[]
  classworkEntries     ClassworkEntry[]
  medicineRecords      MedicineRecord[]
  medicineDoses        MedicineDose[]
  lessonThemes         LessonTheme[]

  @@map("organizations")
}

model User {
  id            String   @id @default(cuid())
  // Null only for class profiles (isProfile) -- a shared tablet login that
  // has no inbox. Postgres allows many NULLs under a unique index.
  email         String?  @unique
  // Class profiles log in with this instead of an email, e.g.
  // "dees.butterfly". Null for every normal email account. Never contains
  // "@", which is how the login form tells the two apart.
  username      String?  @unique
  // A class profile (Dylan, 4 Oct 2026): created by a school admin under
  // Settings -> Team for a classroom tablet, no email, always TEACHER of
  // one class, and never allowed the sensitive permissions in
  // PROFILE_BLOCKED_PERMISSIONS (src/lib/profiles.ts).
  isProfile     Boolean  @default(false)
  // bcrypt hash only, never plaintext or reversibly encrypted.
  passwordHash  String
  name          String
  emailVerified DateTime?
  // Incremented on password change / suspicious activity to invalidate
  // existing sessions/JWTs (checked in the NextAuth jwt callback).
  tokenVersion  Int      @default(0)
  // Grants access to /platform — the SaaS owner's cross-tenant dashboard
  // (subscriber counts, MRR, trials, countries). Completely separate from
  // any per-organization Role: this has nothing to do with, and grants no
  // access to, any individual school's children/payments data. The very
  // first platform admin (the product owner) is instead recognized via the
  // PLATFORM_ADMIN_EMAILS env var (see src/lib/platformAdmin.ts) so there's
  // no chicken-and-egg problem bootstrapping this flag from zero; this
  // column is only for admins invited after that via /platform/team.
  isPlatformAdmin Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships Membership[]
  auditLogs   AuditLog[]
  payments    Payment[] @relation("RecordedBy")
  deletionApprovals DeletionApproval[]
  pushDevices PushDevice[]
  reminderSendApprovals ReminderSendApproval[]
  reviewedTestimonials Testimonial[]
  formDocumentsGenerated FormDocument[]
  parentFormLinksCreated ParentFormLink[] @relation("ParentFormLinkCreatedBy")
  parentSubmissionsReviewed ParentSubmission[] @relation("ParentSubmissionReviewedBy")
  attendanceRecordsMarked AttendanceRecord[]
  childReportsCreated ChildReport[]
  dailySummariesSubmitted DailySummary[]
  lessonPlansCreated      LessonPlan[]
  teacherTasksCreated     TeacherTask[]
  classworkEntriesCreated ClassworkEntry[]
  medicineRecordsCreated  MedicineRecord[]
  medicineDosesGiven      MedicineDose[]
  lessonThemesCreated     LessonTheme[]

  @@map("users")
}

// A user's role within one specific school/organization. A user can belong
// to more than one organization (e.g. an accountant who works with several
// schools), always with an independent role per org.
model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  // TEACHER only: the one class this teacher is scoped to ("own class
  // only" per the plan). Null for every other role. Set/cleared from
  // Settings -> Team by an admin. On delete of the category, this just
  // clears rather than blocking the category's own deletion flow.
  assignedCategoryId String?
  createdAt      DateTime @default(now())
  // Set the first time this person finishes or skips that mode's guided
  // walkthrough (or dismisses it) -- null means "never seen it, show it
  // automatically". A per-user, per-mode timestamp rather than a boolean so
  // it can double as "when" if that's ever useful, same pattern as
  // Child.photoConsentAt.
  centreTourSeenAt     DateTime?
  accountingTourSeenAt DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedCategory Category? @relation(fields: [assignedCategoryId], references: [id], onDelete: SetNull)
  permissionOverrides MembershipPermission[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([assignedCategoryId])
  @@map("memberships")
}

// One row per (membership, permission) that differs from that member's
// role default — see the Permission enum comment. Most members have zero
// rows here (they just get their role's defaults); this table only holds
// the deltas an admin has explicitly set from Settings -> Team.
model MembershipPermission {
  id           String     @id @default(cuid())
  membershipId String
  permission   Permission
  granted      Boolean
  createdAt    DateTime   @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, permission])
  @@index([membershipId])
  @@map("membership_permissions")
}

// Pending invitations. Token is a random opaque string (never the invite id)
// hashed with SHA-256 before storage, same principle as a password reset
// token, so a leaked database dump doesn't hand out valid invite links.
model Invite {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           Role
  tokenHash      String       @unique
  status         InviteStatus @default(PENDING)
  invitedByUserId String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invites")
}

// Category / sub-category hierarchy (e.g. Daycare > Ducks Class, or Primary
// School > Grade 1). Self-referential so nesting depth is not hardcoded.
model Category {
  id             String    @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  monthlyFeeCents Int?      // this class's monthly fee; null = no recurring fee set
  // Age group, in months (e.g. 24-36 = "2-3 years"). Both optional; shown
  // on the Classes page and used to flag children outside the range.
  ageMinMonths   Int?
  ageMaxMonths   Int?
  archived       Boolean   @default(false)
  // Set once a deletion request against this category has 2 admin
  // approvals (see DeletionRequest). A deleted category is hidden from
  // every normal view — stronger than `archived` — and is only visible in
  // Settings → Trash until it's purged (or restored) 30 days later.
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Category?    @relation("CategoryToParent", fields: [parentId], references: [id])
  children     Category[]   @relation("CategoryToParent")
  learners     Child[]
  eventCategories EventCategory[]
  teacherAssignments Membership[]
  scheduleItems ClassScheduleItem[]
  whatsappGroupChecks WhatsAppGroupCheck[]
  reports        ChildReport[]
  dailySummaries DailySummary[]
  lessonPlans    LessonPlan[]
  teacherTasks   TeacherTask[]
  classworkEntries ClassworkEntry[]
  medicineRecords MedicineRecord[]

  @@index([organizationId])
  @@index([parentId])
  @@map("categories")
}

model Child {
  id             String    @id @default(cuid())
  organizationId String
  categoryId     String
  firstName      String
  lastName       String
  parentName     String
  // Stored in E.164 format (e.g. +27821234567), validated against
  // organization.countryCode at the API boundary — see src/lib/validation.ts.
  parentPhone    String?
  parentEmail    String?
  enrollmentDate DateTime
  exitDate       DateTime?
  feeOverrideCents Int?
  // Government/national ID numbers — both optional, per the org owner's
  // own spec for the CSV bulk-import feature ("parents id and childs id
  // which is optional btw"). Free text, not validated against any
  // specific country's ID format for the same reason phone numbers use a
  // loose check: this product works across countries.
  childIdNumber  String?
  parentIdNumber String?
  // Phase 2 (centre management) profile fields -- separate from the
  // billing-facing parentName/parentPhone/parentEmail above, which stay
  // untouched as the Accounting side's billing contact. dateOfBirth and
  // photoImage are both optional since a school can create a bare child
  // record from the Accounting side without ever touching the fuller
  // Centre Management profile.
  dateOfBirth    DateTime?
  gender         Gender?
  // Same data: URL pattern as Organization.logoImage -- small, capped,
  // stored directly in the row. Only ever written together with
  // photoConsentGiven=true in the same request (see validation.ts) --
  // the API rejects setting/changing a photo without consent.
  photoImage        String?   @db.Text
  photoConsentGiven  Boolean   @default(false)
  photoConsentAt     DateTime?
  // Set whenever an admin/accountant/manager marks a payment reminder as
  // sent for this child (see /dashboard/reminders) — purely informational,
  // lets whoever's doing month-end reminders see who's already been
  // nudged without re-checking the audit log for each child.
  // Care details (Dylan, 28 Sept 2026). All optional. The emergency
  // contact is someone OTHER than the parents/guardians on file -- enforced
  // in src/lib/emergencyContact.ts wherever it's written (add child, edit,
  // Excel import).
  allergies                    String?  @db.Text
  // Where the child lives (Dylan, 29 Sept 2026). Free text, optional.
  homeAddress                  String?  @db.Text
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  lastReminderSentAt DateTime?
  archived       Boolean   @default(false)
  // See Category.deletedAt — same soft-trash mechanism, gated the same way
  // by a 2-admin-approved DeletionRequest.
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id])
  planEntries  FinancialPlanEntry[]
  payments     Payment[]
  creditBalance CreditBalance?
  guardians    Guardian[]
  documents    ChildDocument[]
  formDocuments FormDocument[]
  parentFormLinks ParentFormLink[]
  attendanceRecords AttendanceRecord[]
  whatsappGroupChecks WhatsAppGroupCheck[]
  reports      ChildReport[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([organizationId, lastName])
  // Class registers / enrolled lists filter on all of these together.
  @@index([organizationId, categoryId, archived, deletedAt])
  medicineRecords MedicineRecord[]

  @@map("children")
}

// A child's parent(s) or legal guardian(s), mirroring the paper enrolment
// form -- a child can have more than one (mother, father, other legal
// guardian). Deliberately separate from Child.parentName/parentPhone/
// parentEmail, which remain the single billing contact the Accounting
// side has always used; Guardian is the richer Centre Management profile
// data and is never read by any billing code path.
model Guardian {
  id             String    @id @default(cuid())
  organizationId String
  childId        String
  // Free text ("Mother", "Father", "Grandmother", "Legal guardian", ...)
  // rather than an enum -- family/legal arrangements vary too much for a
  // fixed list.
  relationship   String
  firstName      String
  lastName       String
  // Same "optional, free text, not format-validated" treatment as
  // Child.childIdNumber/parentIdNumber above, and masked the same way by
  // the API by default (see src/lib/idMask.ts) with an audit-logged
  // reveal (AuditLog action "child.idNumber.revealed").
  idNumber       String?
  occupation     String?
  phone          String?
  // Up to two more numbers for this parent (Dylan, 28 Sept 2026). `phone`
  // stays the main one (fees, reminders); these are extra "also try" numbers.
  extraPhones    String[]  @default([])
  email          String?
  // Only when it differs from the child's homeAddress (Dylan, 29 Sept 2026).
  address        String?  @db.Text
  // Same data: URL pattern as Child.photoImage -- only ever written
  // together with the child's photoConsentGiven=true.
  photoImage     String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  documents    ChildDocument[]

  @@index([organizationId])
  @@index([childId])
  @@map("guardians")
}

// A generated form-template PDF for one child, e.g. an Indemnity form
// filled with today's data and handed to a parent to sign on paper
// (Phase 2 Session 3 -- staff-generated only; a parent-facing online
// version that writes structured answers back is Session 4, a separate
// build). Every "Generate" click creates a brand-new row rather than
// overwriting the last one for that childId+formType, per Dylan's
// explicit choice: these documents (especially indemnity, photo/media
// consent, medical/allergy) are dated records of what was generated and
// handed out, not just a "current state" like the photo-consent
// checkbox -- so a school can always show what an earlier version said.
// The PDF itself is stored (not just a data snapshot it's rendered
// from), same reasoning and same data: URL-in-row pattern as
// Organization.logoImage/Child.photoImage: it's the actual document as
// it was generated, immune to the layout changing under it later.
model FormDocument {
  id                String   @id @default(cuid())
  organizationId    String
  childId           String
  formType          FormType
  pdf               String   @db.Text
  generatedAt       DateTime @default(now())
  generatedByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  generatedBy  User?        @relation(fields: [generatedByUserId], references: [id])

  @@index([organizationId])
  @@index([childId, formType])
  @@map("form_documents")
}

// The parent-facing online-form flow (Phase 2 Session 4): staff generates
// a one-time link for a specific child, the parent fills it in on their
// phone (no account needed -- the token itself is the proof, same
// pattern as password-reset/invite links), and it lands as a
// ParentSubmission for staff to review. Nothing here writes to the real
// Child/Guardian records until a staff member explicitly approves it --
// see decision made 2026-09-21: this is deliberately a staging area, not
// a direct write, so a typo or a wrong/bad-faith submission never
// silently overwrites real data.
enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model ParentFormLink {
  id              String    @id @default(cuid())
  organizationId  String
  childId         String
  // Only the SHA-256 hash is stored, same reasoning as
  // PasswordResetToken/InviteToken -- see src/lib/inviteToken.ts, reused
  // here rather than duplicated.
  tokenHash       String    @unique
  createdByUserId String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  // Set the moment a submission comes in, so the link can't be reused --
  // one link, one attempt. A parent who needs to redo it gets a fresh
  // link from staff.
  submittedAt     DateTime?
  // "details" = the full update-your-details form (one submission).
  // "documents" = upload missing documents only; each upload goes straight
  // onto the child's file and the link keeps working until it expires.
  purpose         String    @default("details")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  child        Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("ParentFormLinkCreatedBy", fields: [createdByUserId], references: [id])
  submission   ParentSubmission?

  @@index([organizationId])
  @@index([childId])
  @@map("parent_form_links")
}

model ParentSubmission {
  id               String           @id @default(cuid())
  // Set for a per-child "update your details" link; null for a NEW family
  // applying through the school's permanent apply link (isNewApplicant).
  linkId           String?          @unique
  isNewApplicant   Boolean          @default(false)
  // Set when a new applicant is approved and becomes a real Child.
  createdChildId   String?
  // Denormalized from the link at submission time so this row can be
  // queried/scoped directly (the "Pending reviews" list) without joining
  // through ParentFormLink for every row.
  organizationId   String
  // The parent's answers, as one JSON blob (child fields + a guardians
  // array) validated by parentSubmissionSchema at write time --
  // deliberately not split into real columns since none of it is real
  // until approved; see ParentSubmissionAttachment for the accompanying
  // ID-document photos.
  data             String           @db.Text
  submittedAt      DateTime         @default(now())
  status           SubmissionStatus @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNotes      String?

  link         ParentFormLink?              @relation(fields: [linkId], references: [id], onDelete: Cascade)
  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewedBy   User?                        @relation("ParentSubmissionReviewedBy", fields: [reviewedByUserId], references: [id])
  attachments  ParentSubmissionAttachment[]
  documents    ChildDocument[]

  @@index([organizationId, status])
  @@map("parent_submissions")
}

// A document kept on file for a child (Dylan, 30 Sept 2026): birth
// certificate, clinic card, a parent's ID, ... -- `type` is a key from
// src/lib/documents.ts. Stored as a data: URL in the row like every other
// upload in this app (photo or PDF, one per row).
//
// status ACTIVE = on the child's file. PENDING = a parent uploaded it
// while filling in an online form that staff haven't approved yet: it has
// no child (new family) or isn't counted yet (existing child) until the
// submission is approved; uploads never attached to a submission are
// removed by the daily purge after 2 days.
model ChildDocument {
  id               String    @id @default(cuid())
  organizationId   String
  childId          String?
  guardianId       String?
  // Which parent in the submitted form a pending ID belongs to; resolved
  // to guardianId when the submission is approved.
  guardianIndex    Int?
  type             String
  fileName         String?
  contentType      String    @default("image/jpeg")
  fileData         String    @db.Text
  status           String    @default("ACTIVE")
  // "staff" or "parent"
  source           String    @default("staff")
  uploadedByUserId String?
  // Random key the parent's browser holds while filling in a form, so only
  // that browser can attach its uploads to its own submission.
  uploadKey        String?
  submissionId     String?
  createdAt        DateTime  @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  child        Child?            @relation(fields: [childId], references: [id], onDelete: Cascade)
  guardian     Guardian?         @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  submission   ParentSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([childId])
  @@index([submissionId])
  @@map("child_documents")
}

model ParentSubmissionAttachment {
  id           String   @id @default(cuid())
  submissionId String
  // "CHILD_ID" or "GUARDIAN_ID" -- which proof field this photo backs,
  // per Dylan's explicit choice (2026-09-21) that attachments back a
  // specific existing ID field rather than being a loose document dump.
  kind         String
  // Human-readable, e.g. "Child's ID document" or "Naledi Kekana's ID
  // document" -- shown as-is on the staff review page.
  label        String
  // Same data: URL-in-row pattern as every other photo field in this
  // app (Child.photoImage, FormDocument.pdf, ...).
  image        String   @db.Text
  uploadedAt   DateTime @default(now())

  submission ParentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("parent_submission_attachments")
}

// Phase 3 Session 1 (Daily running -- attendance, see docs/PLAN.md).
// PRESENT/ABSENT only -- deliberately no Late/Excused in this first pass,
// matching the plan's own wording and "simple beats complete." Add more
// statuses later if a school actually asks.
enum AttendanceStatus {
  PRESENT
  ABSENT
}

// One row per child per calendar day. `date` is stored the same way as
// every other date-only field in this app (Child.enrollmentDate,
// Child.dateOfBirth) -- midnight UTC of the intended calendar day, never
// used as a real timestamp. Deliberately NOT scoped by categoryId here:
// a child's class can change over the year, and "which class was this
// for" is answered by joining Child.categoryId as of now, same as every
// other class-scoped query in this app (children list, admissions,
// enrolled). A TEACHER can only read/write rows for children in their
// own Membership.assignedCategoryId -- enforced in the API route, same
// pattern as MANAGE_CHILDREN.
model AttendanceRecord {
  id             String            @id @default(cuid())
  organizationId String
  childId        String
  date           DateTime
  status         AttendanceStatus
  markedByUserId String
  markedAt       DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  // Set once an absence email has actually been sent for this record, so
  // "Notify absent parents" never double-emails the same parent for the
  // same day if clicked twice (or clicked by two staff members), and so
  // the UI can show "Notified" instead of a live "Notify" action.
  notifiedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  markedBy     User         @relation(fields: [markedByUserId], references: [id])

  @@unique([childId, date])
  @@index([organizationId, date])
  @@map("attendance_records")
}

// Centre Management Reports (Dylan, 1 Oct 2026): incident, academic and
// disciplinary/behaviour reports, one per child per occurrence. categoryId
// is a snapshot of the child's class at the time the report was written,
// so a teacher's old reports still show "which class" even after the
// child moves up, and so a TEACHER's own-class scoping stays correct for
// reports written while that was in fact their class.
model ChildReport {
  id             String     @id @default(cuid())
  organizationId String
  childId        String
  categoryId     String
  type           ReportType
  occurredAt     DateTime // date (and, for INCIDENT, time) the thing happened
  summary        String     @db.Text // what happened / observed -- every type's main free-text field

  // INCIDENT-only fields (null for ACADEMIC/DISCIPLINARY).
  injury         Boolean?
  firstAidGiven  Boolean?
  witnesses      String?    @db.Text
  actionTaken    String?    @db.Text
  // Fields from the school's paper "Daycare Incident Report" (4 Oct 2026).
  // All optional so reports written before they existed stay valid.
  incidentTime          String? // "HH:MM" on the school's clock, kept apart from occurredAt (date only)
  location              String?
  incidentTypes         String[] @default([]) // codes from INCIDENT_TYPES in src/lib/reports.ts
  incidentTypeOther     String?
  caregiver             String?
  emergencyCareRequired Boolean?
  staffConsulted        Boolean?
  witnessesPresent      Boolean?

  // ACADEMIC-only fields.
  term           String? // e.g. "Term 3 2026"
  developmentArea String? // e.g. "Gross motor", "Language", "Social/emotional"
  rating         String? // a short scale value, free text so a school can use its own wording

  // DISCIPLINARY-only fields.
  behaviour      String?    @db.Text // the specific behaviour observed, separate from the narrative `summary`
  followUp       String?    @db.Text

  parentNotified   Boolean   @default(false)
  parentNotifiedAt DateTime?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id])
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@index([organizationId, type, occurredAt])
  @@index([childId, occurredAt])
  @@index([categoryId])
  @@map("child_reports")
}

// Phase 5: a class's fixed weekly timetable (Mon-Fri). The whole week for
// one class is replaced in a single save. Times are "HH:MM" strings in the
// school's local time -- no timezone maths needed for a repeating week.
// Teachers read their own class's timetable; MANAGE_CLASSES edits it.
// "Timetable changed" teacher to-dos come from AuditLog
// (schedule.updated vs schedule.acknowledged), so no extra column here.
// The class teacher's end-of-day summary (Dylan, 4 Oct 2026). From 16:00
// school time every weekday, each class with a teacher must answer: did
// any child get hurt under your supervision today? If yes, either an
// incident report exists for today or a reason is given. One per class
// per school day; the admin sees which classes haven't submitted.
model DailySummary {
  id                String   @id @default(cuid())
  organizationId    String
  categoryId        String
  // The school day, date-only (UTC midnight), same convention as
  // AttendanceRecord.date.
  date              DateTime
  anyoneHurt        Boolean
  // Only when anyoneHurt: true = incident report(s) filed for today
  // (checked on submit), false = see noReportReason.
  incidentReported  Boolean?
  noReportReason    String?  @db.Text
  // Questions 2-5 of the daily report (5 Oct 2026). Null on summaries sent
  // before they existed.
  anyoneIll         Boolean?
  illDetails        String?  @db.Text
  routineFollowed   String?  // "YES" | "MOSTLY" | "NO"
  routineNote       String?  @db.Text
  childrenNote      String?  @db.Text
  needsNote         String?  @db.Text
  submittedByUserId String
  submittedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id])
  submittedBy  User         @relation(fields: [submittedByUserId], references: [id])

  @@unique([categoryId, date])
  @@index([organizationId, date])
  @@map("daily_summaries")
}

model ClassScheduleItem {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String
  dayOfWeek      Int // 1 = Monday ... 5 = Friday (ISO weekday)
  startTime      String // "HH:MM", 24h
  endTime        String? // "HH:MM", 24h
  activity       String
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([categoryId, dayOfWeek])
  @@map("class_schedule_items")
}

// Phase 5 Communication tab: a manual tick that a child's parent has been
// added to their class's WhatsApp group. No WhatsApp integration. Keyed per
// child per class, so a child who moves class shows unticked for the new
// class's group. addedByUserId is a plain column (no relation) on purpose.
model WhatsAppGroupCheck {
  id             String   @id @default(cuid())
  organizationId String
  childId        String
  categoryId     String
  addedAt        DateTime @default(now())
  addedByUserId  String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([childId, categoryId])
  @@index([organizationId])
  @@index([categoryId])
  @@map("whatsapp_group_checks")
}

model PaymentType {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isRecurring    Boolean  @default(false)
  // Used for one-time charges (Registration, Uniform, Trip) generated
  // automatically — e.g. the mandatory Registration charge on enrollment.
  // Recurring types (School Fees) ignore this and use the category's
  // monthlyFeeCents / the child's feeOverrideCents instead.
  defaultAmountCents Int?
  active         Boolean  @default(true)
  // True for the dedicated PaymentType an Event auto-creates for itself
  // (see the Event model) — kept out of the manually-managed Payment Types
  // settings list so admins aren't confused by dozens of one-off event
  // types mixed in with the ones they actually curate, but it still works
  // exactly like any other one-time type for recording/allocating a
  // payment against it.
  isEventType    Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planEntries  FinancialPlanEntry[]
  event        Event?

  @@index([organizationId])
  @@map("payment_types")
}

// A one-time, class-wide charge (e.g. "September Trip — R750") — spec
// section 9. Creating an Event auto-generates a one-time FinancialPlanEntry
// for every active child in the selected category/categories via its own
// dedicated one-time PaymentType (so it reuses the existing payment
// recording/allocation machinery instead of inventing a parallel one). An
// admin can later remove an individual child (deleting their entry) if
// they're not participating — see the events API routes for the rule that
// blocks removing a child who has already paid.
model Event {
  id             String   @id @default(cuid())
  organizationId String
  // Null for a free event -- no PaymentType, no charges, no billing
  // footprint at all. Non-null (and amountCents non-null) for a paid one,
  // same as before this field became optional.
  paymentTypeId  String?  @unique
  name           String
  eventDate      DateTime
  amountCents    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentType  PaymentType?    @relation(fields: [paymentTypeId], references: [id])
  categories   EventCategory[]

  @@index([organizationId])
  @@map("events")
}

model EventCategory {
  id         String @id @default(cuid())
  eventId    String
  categoryId String

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([eventId, categoryId])
  @@index([categoryId])
  @@map("event_categories")
}

// One row per child, per month/charge, per payment type. Recurring monthly
// fee rows are generated from enrollment/exit dates; one-time rows (events,
// registration) are created directly. Amounts are locked at creation time —
// changing a fee later does not retroactively alter existing rows.
model FinancialPlanEntry {
  id             String          @id @default(cuid())
  organizationId String
  childId        String
  paymentTypeId  String
  year           Int
  month          Int?            // 1-12, null for one-time (event/registration) charges
  description    String
  amountDueCents Int
  amountPaidCents Int            @default(0)
  status         PlanEntryStatus @default(OUTSTANDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Restrict, not Cascade: deleting a child (trash purge) or a school must
  // never silently erase charges (final inspection R7/R13).
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  child        Child             @relation(fields: [childId], references: [id], onDelete: Restrict)
  paymentType  PaymentType       @relation(fields: [paymentTypeId], references: [id])
  allocations  PaymentAllocation[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, year])
  @@index([childId, year, month])
  @@map("financial_plan_entries")
}

model Payment {
  id              String        @id @default(cuid())
  organizationId  String
  childId         String
  amountCents     Int
  method          PaymentMethod
  date            DateTime
  reference       String?
  notes           String?
  recordedByUserId String
  createdAt       DateTime      @default(now())

  // Restrict: a school's payment history is never deleted by cascade (R13).
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  child        Child               @relation(fields: [childId], references: [id])
  recordedBy   User                @relation("RecordedBy", fields: [recordedByUserId], references: [id])
  allocations  PaymentAllocation[]
  receipt      Receipt?

  @@index([organizationId])
  @@index([organizationId, date])
  @@index([childId])
  @@map("payments")
}

model PaymentAllocation {
  id                   String @id @default(cuid())
  paymentId            String
  financialPlanEntryId String
  amountCents          Int

  payment            Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  financialPlanEntry FinancialPlanEntry  @relation(fields: [financialPlanEntryId], references: [id])

  @@index([paymentId])
  @@index([financialPlanEntryId])
  @@map("payment_allocations")
}

model Receipt {
  id            String   @id @default(cuid())
  paymentId     String   @unique
  number        String   @unique // REC-{year}-{6-digit sequence}
  createdAt     DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

model CreditBalance {
  id             String   @id @default(cuid())
  organizationId String
  childId        String   @unique
  amountCents    Int      @default(0)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Restrict: credit is money owed back to a parent (R7).
  child        Child        @relation(fields: [childId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("credit_balances")
}

// Pending invitations to become a platform admin (owner of the whole SaaS,
// not any one school). Same token-hash-only pattern as Invite — see that
// model's comment — and deliberately its own table rather than reusing
// Invite, since a platform invite has no organizationId at all.
model PlatformInvite {
  id              String       @id @default(cuid())
  email           String
  tokenHash       String       @unique
  status          InviteStatus @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime
  createdAt       DateTime     @default(now())

  @@map("platform_invites")
}

// "Forgot password" flow. Same shape/security model as PlatformInvite's
// token: only the SHA-256 hash is stored, the raw token lives only in the
// emailed link and is never persisted, and it's single-use + short-lived
// (usedAt set, or expiresAt passed, both make it dead). Deliberately not a
// column on User (a user could in theory have more than one outstanding
// request; each one gets its own row and old ones don't need cleanup logic
// beyond "the where clause ignores them").
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Same shape/reasoning as PasswordResetToken directly above -- only the
// SHA-256 hash is stored (src/lib/inviteToken.ts), one-time use via
// usedAt, and expires. Created at registration (src/app/api/auth/register)
// and consumed by POST /api/auth/verify-email. Deliberately its own table
// rather than reusing PasswordResetToken: the two tokens must never be
// interchangeable (a leaked/guessed password-reset link must not also be
// able to mark an email verified, or vice versa).
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

// Append-only trail: who did what, when. Required both for the "Frank
// viewed records" activity feed the product spec asks for, and for being
// able to answer "who accessed/changed this record" if a customer or
// regulator ever asks after an incident.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String   // e.g. "payment.created", "child.archived", "statement.viewed"
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  // Timetable "changed" to-do lookups (src/lib/scheduleNotice.ts).
  @@index([organizationId, entityType, entityId, createdAt])
  @@map("audit_logs")
}

// The record of every deletion: who deleted what, when, and why. Since
// 4 Oct 2026 (Dylan) deleting is one step for an admin, so new rows are
// written already APPROVED with one DeletionApproval (the admin who
// deleted). A class or child gets `deletedAt` and sits in Settings → Trash,
// restorable, until purged 30 days later; a payment is reversed at once.
// PENDING rows are leftovers from the old two-approval flow.
model DeletionRequest {
  id                String                 @id @default(cuid())
  organizationId    String
  targetType        DeletionTargetType
  targetId          String
  // Snapshot of the target's display name at request time, so the
  // approval queue and trash list still read sensibly even though the
  // underlying row may itself be gone by the time someone looks.
  targetLabel       String
  // Why it was deleted. Required for a payment (it can't be restored),
  // optional for a class or child, which go to Trash ("" when not given).
  reason            String                 @default("") @db.Text
  status            DeletionRequestStatus  @default(PENDING)
  requestedByUserId String
  createdAt         DateTime               @default(now())
  resolvedAt        DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvals    DeletionApproval[]

  @@index([organizationId, status])
  @@index([targetType, targetId])
  @@map("deletion_requests")
}

// One row per admin who has approved a given request. The unique
// constraint is what actually prevents one admin's approval from being
// (accidentally or otherwise) counted twice.
model DeletionApproval {
  id                String   @id @default(cuid())
  deletionRequestId String
  userId            String
  createdAt         DateTime @default(now())

  deletionRequest DeletionRequest @relation(fields: [deletionRequestId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deletionRequestId, userId])
  @@map("deletion_approvals")
}

// "Send all reminders" — the same request → 2-people-approve → execute
// shape as DeletionRequest/DeletionApproval above, but for a different
// action (emailing every parent with an outstanding balance) and a
// different approval pool: any 2 *distinct* ADMIN or ACCOUNTANT people
// (any combination, "director" already maps to ADMIN elsewhere in this
// app) — never a Viewer — per the org owner's own spec. Reuses
// DeletionRequestStatus since the three states (PENDING/APPROVED/
// CANCELLED) mean exactly the same thing here.
model ReminderSendRequest {
  id                String                @id @default(cuid())
  organizationId    String
  status            DeletionRequestStatus @default(PENDING)
  requestedByUserId String
  // How many reminders were outstanding at request time — shown in the
  // approval queue so an approver knows roughly what they're approving
  // without needing to separately open the Reminders page first. The
  // actual send recomputes the live list at execution time rather than
  // trusting this snapshot, since it could be stale by the time the 2nd
  // approval lands.
  reminderCountAtRequest Int
  createdAt         DateTime              @default(now())
  resolvedAt        DateTime?

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvals    ReminderSendApproval[]

  @@index([organizationId, status])
  @@map("reminder_send_requests")
}

model ReminderSendApproval {
  id                     String   @id @default(cuid())
  reminderSendRequestId  String
  userId                 String
  createdAt              DateTime @default(now())

  reminderSendRequest ReminderSendRequest @relation(fields: [reminderSendRequestId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reminderSendRequestId, userId])
  @@map("reminder_send_approvals")
}

// Public marketing-site testimonials. Deliberately standalone — not tied
// to an Organization/User — since anyone (a parent, a school director, a
// prospective customer who just wants to say something) can submit one
// without an account. Nothing here shows on the homepage until a platform
// admin (dylanmaps3@gmail.com today, via PLATFORM_ADMIN_EMAILS — see
// src/lib/platformAdmin.ts) approves it: see CRECHELY_AUDIT.md's rule
// against ever inventing or auto-publishing proof.
enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

model Testimonial {
  id           String             @id @default(cuid())
  authorName   String
  schoolName   String?
  quote        String
  status       TestimonialStatus  @default(PENDING)
  createdAt    DateTime           @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  reviewedBy User? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("testimonials")
}

// One row per successful Crechely subscription charge (first payment and
// every renewal), recorded from Paystack's charge.success webhook. Powers
// the payment history + downloadable receipts on Settings -> Billing
// (Dylan, 28 Sept 2026). paystackReference is unique so a webhook Paystack
// retries can never record the same payment twice. receiptNumber is a
// simple running number across the whole platform, printed as CRE-000001.
model SubscriptionPayment {
  id                String   @id @default(cuid())
  receiptNumber     Int      @unique @default(autoincrement())
  organizationId    String
  paystackReference String   @unique
  amountCents       Int
  currencyCode      String
  paidAt            DateTime
  // The period this payment covers (paidAt to paidAt + plan interval).
  periodStart       DateTime
  periodEnd         DateTime
  planCode          String?
  planName          String?
  planInterval      String? // "monthly" | "annually" (Paystack's own values)
  channel           String? // "card", "eft", ...
  cardBrand         String?
  cardLast4         String?
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, paidAt])
  @@map("subscription_payments")
}

// What each class is learning on a given school day (Dylan, 5 Oct 2026).
// The admin writes it a week at a time; the class teacher reads it. One
// topic per class per day.
model LessonPlan {
  id              String   @id @default(cuid())
  organizationId  String
  categoryId      String
  // The school day, date-only (UTC midnight), same convention as
  // AttendanceRecord.date.
  date            DateTime
  topic           String
  notes           String?  @db.Text
  // How to teach it (Dylan, 5 Oct 2026): written by an admin only, optional.
  guide           String?  @db.Text
  // The week's theme this day belongs to ("Numbers and shapes"), if any.
  themeId         String?
  // Teachers can propose a plan; the admin approves it or sends it back.
  // "APPROVED" (what an admin writes), "PENDING", "RETURNED".
  status           String    @default("APPROVED")
  reviewNote       String?   @db.Text
  reviewedAt       DateTime?
  reviewedByUserId String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id])
  createdBy    User         @relation(fields: [createdByUserId], references: [id])
  theme        LessonTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)

  @@unique([categoryId, date])
  @@index([organizationId, date])
  @@index([themeId])
  @@map("lesson_plans")
}

// A theme for a stretch of school days (Dylan, 5 Oct 2026): "Numbers and
// shapes", 5 to 9 Oct, for every class or chosen ones. Each class then gets
// its own topic and teaching guide per day (LessonPlan), pitched at its age.
model LessonTheme {
  id              String   @id @default(cuid())
  organizationId  String
  title           String
  description     String?  @db.Text
  startDate       DateTime // school date, UTC midnight
  endDate         DateTime
  // Empty means every class.
  categoryIds     String[] @default([])
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdByUserId], references: [id])
  plans        LessonPlan[]

  @@index([organizationId, startDate, endDate])
  @@map("lesson_themes")
}

// What the class teacher did with the children today (Dylan, 5 Oct 2026).
// Teachers only add, for today; they never edit or delete. Photos can
// attach to these later.
model ClassworkEntry {
  id              String   @id @default(cuid())
  organizationId  String
  categoryId      String
  date            DateTime
  description     String   @db.Text
  createdByUserId String
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id])
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@index([organizationId, date])
  @@index([categoryId, date])
  @@map("classwork_entries")
}

// Work an admin hands to a class (Dylan, 5 Oct 2026): "Admin has assigned
// you to ...". Goes to the class's teacher(s) and its tablet; the first to
// open the pop-up acknowledges it, any of them can mark it done.
model TeacherTask {
  id                   String    @id @default(cuid())
  organizationId       String
  categoryId           String
  title                String
  details              String?   @db.Text
  dueDate              DateTime? // date-only, school day
  createdByUserId      String
  createdAt            DateTime  @default(now())
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  completedAt          DateTime?
  completedByUserId    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id])
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@index([organizationId, completedAt])
  @@index([categoryId, completedAt])
  @@map("teacher_tasks")
}

// Medicine register (Dylan, 5 Oct 2026). One row per medicine a parent
// brings in, with the parent's signed permission. The consent wording the
// parent agreed to is versioned in src/lib/medicine.ts (consentVersion).
// The signature is a small PNG data URL; it is health-related data under
// POPIA, so it is only ever read through the scoped medicine routes.
model MedicineRecord {
  id                String    @id @default(cuid())
  organizationId    String
  childId           String
  categoryId        String
  medicineName      String
  reason            String
  isPrescribed      Boolean   @default(false)
  prescriberName    String?
  dose              String // "5 ml", "1 tablet"
  route             String // ORAL, TOPICAL, INHALER, EYE_EAR_NOSE, OTHER
  frequency         String // "Twice a day, after food"
  scheduledTimes    String[]  @default([]) // "HH:MM" on the school's clock
  startDate         DateTime // school date, UTC midnight
  endDate           DateTime
  lastDoseAtHome    String?
  storage           String // ROOM, FRIDGE, CHILD_CARRIES
  expiryDate        DateTime?
  originalContainer Boolean   @default(false)
  labelMatches      Boolean   @default(false)
  notExpired        Boolean   @default(false)
  specialInstructions String? @db.Text

  // Parent permission. Null until the parent signs.
  consentVersion    Int       @default(1)
  parentName        String?
  parentRelationship String?
  parentPhone       String?
  signatureImage    String?   @db.Text
  signedAt          DateTime?
  signedWitnessUserId String? // the staff member who handed over the tablet

  // Finished, or the unused medicine went back to the parent.
  returnedAt        DateTime?
  returnedNote      String?

  createdByUserId   String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  child        Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  category     Category       @relation(fields: [categoryId], references: [id])
  createdBy    User           @relation(fields: [createdByUserId], references: [id])
  doses        MedicineDose[]

  @@index([organizationId, startDate, endDate])
  @@index([categoryId, startDate, endDate])
  @@index([childId])
  @@map("medicine_records")
}

// One entry per time staff gave (or tried to give) a dose: the
// "administration record" childcare regulators ask for.
model MedicineDose {
  id               String   @id @default(cuid())
  organizationId   String
  medicineRecordId String
  givenAt          DateTime @default(now())
  outcome          String // GIVEN, REFUSED, VOMITED, NOT_GIVEN
  doseGiven        String?
  note             String?  @db.Text
  witnessName      String? // second staff member who checked, when there was one
  givenByUserId    String

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  medicineRecord MedicineRecord @relation(fields: [medicineRecordId], references: [id], onDelete: Cascade)
  givenBy        User           @relation(fields: [givenByUserId], references: [id])

  @@index([medicineRecordId, givenAt])
  @@index([organizationId, givenAt])
  @@map("medicine_doses")
}

// A tablet or phone running the Crechely Android app (Dylan, 7 Oct 2026).
// The app is the website in a native shell; this table only records where to
// send it push notifications and alarms. fcmToken is Firebase's address for
// the device. It belongs to whoever signed in on that device last.
model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  fcmToken   String   @unique
  deviceName String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Shared rate-limit counters (security review #4, 7 Oct 2026). One row per
// hashed key ("login:email:<sha256>"), updated with an atomic upsert in
// src/lib/rateLimit.ts so every server instance sees the same count.
// Expired rows are deleted by the daily purge cron.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limit_buckets")
}
