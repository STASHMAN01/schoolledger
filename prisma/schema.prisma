// SchoolLedger — multi-tenant schema
//
// SECURITY NOTES (read before changing this file):
// - Every tenant-owned table carries an explicit organizationId column and an
//   index on it. ALL application queries must filter by organizationId — see
//   src/lib/tenant.ts, which is the only place allowed to build that filter.
// - No table stores a plaintext password. User.passwordHash is a bcrypt hash
//   only (see src/lib/auth.ts).
// - Money is stored as integer "cents" (amountCents) to avoid floating point
//   errors in financial calculations — never store money as Float.
// - AuditLog is append-only from the application's point of view: nothing in
//   this codebase should ever update or delete an AuditLog row.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN // full access: billing, settings, invite/remove users, all data
  ACCOUNTANT // record payments, manage children/categories, generate statements
  MANAGER // manage children/categories, cannot see money (see src/lib/permissions.ts)
  VIEWER // read-only, scope limited by ViewerScope
  TEACHER // Centre Management only, own assigned class only (assignedCategoryId)
  RECEPTIONIST // Centre Management only, can add children org-wide
}

// A specific, closed-set capability a member may or may not have. Roles
// (above) only decide the DEFAULT set of these (see
// src/lib/permissions.ts's ROLE_DEFAULT_PERMISSIONS) — the actual
// effective set for any one person is that default, adjusted by whatever
// MembershipPermission override rows exist for them. This is what lets an
// admin loosen/tighten one specific person's access without inventing a
// new role for them. ADMIN is special-cased in code to always have every
// permission, not stored/overridable as rows.
enum Permission {
  VIEW_CENTRE // can switch into Centre Management mode
  VIEW_ACCOUNTING // can switch into Accounting mode
  VIEW_MONEY // can see payment amounts, statements, financial totals
  RECORD_PAYMENTS // can record/edit payments
  MANAGE_CHILDREN // can add/edit/archive children (TEACHER: own assigned class only)
  MANAGE_CLASSES // can add/edit/archive classes
  MANAGE_EVENTS // can create one-time class-wide charges (events)
  SEND_REMINDERS // can mark reminders sent; combined with VIEW_MONEY, can run/approve "send all"
  REQUEST_DELETION // can request a category/child/payment be deleted
  APPROVE_DELETION // can approve a pending deletion request (2 needed) or restore from trash
  MANAGE_TEAM // can invite/remove members, change their role/permissions
  MANAGE_BILLING // can manage the org's own subscription
  MANAGE_SETTINGS // can edit org profile/letterhead and payment types
  VIEW_ACTIVITY_LOG // can view the audit/activity feed
  MANAGE_ATTENDANCE // can take/edit attendance and notify absent parents (TEACHER: own assigned class only)
  EXPORT_DATA // can download a full password-protected backup of the organization's data
}

// A child's gender, for the Enrolled tile's gender breakdown chart
// (Phase 2 Session 2). Optional -- a school can leave it blank, same as
// ID numbers. Deliberately NOT the same category as ethnicity (dropped
// entirely, see docs/PLAN.md decision #5, over POPIA/legal caution) --
// gender wasn't flagged as needing that same check.
enum Gender {
  MALE
  FEMALE
  OTHER
}

// The 7 pre-built form templates (Phase 2 Session 3, see docs/PLAN.md
// decision #6) -- a fixed catalog defined in code (src/lib/forms/), not a
// user-editable list, per decision #8 (form builder approach, not
// arbitrary PDF editing/bring-your-own-PDF).
enum FormType {
  ENROLMENT
  RE_REGISTRATION
  INDEMNITY
  MEDICAL_ALLERGY
  PHOTO_MEDIA_CONSENT
  EMERGENCY_CONTACT_PICKUP
  FEE_AGREEMENT
}

enum PaymentMethod {
  CASH
  EFT
  CARD
  OTHER
}

enum PlanEntryStatus {
  UPCOMING
  OUTSTANDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DeletionTargetType {
  CATEGORY
  CHILD
  PAYMENT
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  CANCELLED
}

model Organization {
  id                String   @id @default(cuid())
  name              String
  countryCode       String // ISO 3166-1 alpha-2, drives currency + phone format
  currencyCode      String // ISO 4217, e.g. ZAR, USD
  addressLine1      String?
  addressLine2      String?
  province           String?
  logoUrl           String? // deprecated — superseded by logoImage (direct upload), kept so no column is dropped
  letterheadUrl     String? // deprecated — superseded by letterheadImage (direct upload), kept so no column is dropped
  // Uploaded images, stored as data: URLs (base64) directly in the row —
  // small enough (capped client- and server-side, see validation.ts) that
  // this avoids standing up separate blob storage/credentials for what is,
  // for a preschool's logo and letterhead, a handful of small images.
  logoImage         String?  @db.Text
  letterheadImage   String?  @db.Text
  contactName       String? // a real person to contact about the account (not necessarily an app user)
  contactEmail      String?
  contactPhone      String?
  bankName          String?
  // Never store full bank account numbers in plaintext beyond what's needed
  // to print on a statement. Kept optional and separate from anything else
  // sensitive so it can be encrypted-at-rest (see SECURITY.md) without a
  // schema change later (encryption handled at the field level in app code).
  bankAccountNumber String?
  timezone          String   @default("Africa/Johannesburg")
  // The org's chosen reminder message wording, with {{childName}} /
  // {{parentName}} / {{schoolName}} / {{amount}} placeholder tokens — see
  // src/lib/billing/reminderTemplates.ts, which owns the built-in options,
  // rendering, and the "must contain the 3 required placeholders" rule.
  // Null means "use the default built-in template" (REMINDER_TEMPLATES[0])
  // rather than duplicating that default text into the database.
  reminderMessageTemplate String? @db.Text
  paystackCustomerCode     String?  @unique
  paystackSubscriptionCode String?  @unique
  paystackPlanCode         String?
  // Only ever issued once, on the subscription.create webhook event, and
  // never retrievable again afterwards — required (alongside the
  // subscription code) to call Paystack's POST /subscription/disable when
  // an admin cancels from the app. See src/lib/paystack.ts.
  paystackEmailToken       String?
  // trialing | active | past_due | canceled | incomplete — a payment-
  // provider-agnostic vocabulary the app's own access checks key off of
  // (see src/lib/billing/access.ts). The Paystack webhook handler
  // translates Paystack's own event/status vocabulary into these values
  // (see src/app/api/webhooks/paystack/route.ts) rather than the app
  // adopting Paystack's vocabulary directly.
  subscriptionStatus String  @default("trialing")
  currentPeriodEnd  DateTime?
  trialEndsAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  memberships   Membership[]
  invites       Invite[]
  categories    Category[]
  children      Child[]
  paymentTypes  PaymentType[]
  planEntries   FinancialPlanEntry[]
  payments      Payment[]
  creditBalances CreditBalance[]
  auditLogs     AuditLog[]
  events        Event[]
  deletionRequests DeletionRequest[]
  reminderSendRequests ReminderSendRequest[]
  guardians     Guardian[]
  formDocuments FormDocument[]
  parentFormLinks ParentFormLink[]
  parentSubmissions ParentSubmission[]
  attendanceRecords AttendanceRecord[]
  scheduleItems ClassScheduleItem[]
  whatsappGroupChecks WhatsAppGroupCheck[]

  @@map("organizations")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  // bcrypt hash only, never plaintext or reversibly encrypted.
  passwordHash  String
  name          String
  emailVerified DateTime?
  // Incremented on password change / suspicious activity to invalidate
  // existing sessions/JWTs (checked in the NextAuth jwt callback).
  tokenVersion  Int      @default(0)
  // Grants access to /platform — the SaaS owner's cross-tenant dashboard
  // (subscriber counts, MRR, trials, countries). Completely separate from
  // any per-organization Role: this has nothing to do with, and grants no
  // access to, any individual school's children/payments data. The very
  // first platform admin (the product owner) is instead recognized via the
  // PLATFORM_ADMIN_EMAILS env var (see src/lib/platformAdmin.ts) so there's
  // no chicken-and-egg problem bootstrapping this flag from zero; this
  // column is only for admins invited after that via /platform/team.
  isPlatformAdmin Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships Membership[]
  auditLogs   AuditLog[]
  payments    Payment[] @relation("RecordedBy")
  deletionApprovals DeletionApproval[]
  reminderSendApprovals ReminderSendApproval[]
  reviewedTestimonials Testimonial[]
  formDocumentsGenerated FormDocument[]
  parentFormLinksCreated ParentFormLink[] @relation("ParentFormLinkCreatedBy")
  parentSubmissionsReviewed ParentSubmission[] @relation("ParentSubmissionReviewedBy")
  attendanceRecordsMarked AttendanceRecord[]

  @@map("users")
}

// A user's role within one specific school/organization. A user can belong
// to more than one organization (e.g. an accountant who works with several
// schools), always with an independent role per org.
model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  // TEACHER only: the one class this teacher is scoped to ("own class
  // only" per the plan). Null for every other role. Set/cleared from
  // Settings -> Team by an admin. On delete of the category, this just
  // clears rather than blocking the category's own deletion flow.
  assignedCategoryId String?
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedCategory Category? @relation(fields: [assignedCategoryId], references: [id], onDelete: SetNull)
  permissionOverrides MembershipPermission[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([assignedCategoryId])
  @@map("memberships")
}

// One row per (membership, permission) that differs from that member's
// role default — see the Permission enum comment. Most members have zero
// rows here (they just get their role's defaults); this table only holds
// the deltas an admin has explicitly set from Settings -> Team.
model MembershipPermission {
  id           String     @id @default(cuid())
  membershipId String
  permission   Permission
  granted      Boolean
  createdAt    DateTime   @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, permission])
  @@index([membershipId])
  @@map("membership_permissions")
}

// Pending invitations. Token is a random opaque string (never the invite id)
// hashed with SHA-256 before storage, same principle as a password reset
// token, so a leaked database dump doesn't hand out valid invite links.
model Invite {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           Role
  tokenHash      String       @unique
  status         InviteStatus @default(PENDING)
  invitedByUserId String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invites")
}

// Category / sub-category hierarchy (e.g. Daycare > Ducks Class, or Primary
// School > Grade 1). Self-referential so nesting depth is not hardcoded.
model Category {
  id             String    @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  monthlyFeeCents Int?      // null = inherits nothing; leaf categories should set this
  archived       Boolean   @default(false)
  // Set once a deletion request against this category has 2 admin
  // approvals (see DeletionRequest). A deleted category is hidden from
  // every normal view — stronger than `archived` — and is only visible in
  // Settings → Trash until it's purged (or restored) 30 days later.
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Category?    @relation("CategoryToParent", fields: [parentId], references: [id])
  children     Category[]   @relation("CategoryToParent")
  learners     Child[]
  eventCategories EventCategory[]
  teacherAssignments Membership[]
  scheduleItems ClassScheduleItem[]
  whatsappGroupChecks WhatsAppGroupCheck[]

  @@index([organizationId])
  @@index([parentId])
  @@map("categories")
}

model Child {
  id             String    @id @default(cuid())
  organizationId String
  categoryId     String
  firstName      String
  lastName       String
  parentName     String
  // Stored in E.164 format (e.g. +27821234567), validated against
  // organization.countryCode at the API boundary — see src/lib/validation.ts.
  parentPhone    String?
  parentEmail    String?
  enrollmentDate DateTime
  exitDate       DateTime?
  feeOverrideCents Int?
  // Government/national ID numbers — both optional, per the org owner's
  // own spec for the CSV bulk-import feature ("parents id and childs id
  // which is optional btw"). Free text, not validated against any
  // specific country's ID format for the same reason phone numbers use a
  // loose check: this product works across countries.
  childIdNumber  String?
  parentIdNumber String?
  // Phase 2 (centre management) profile fields -- separate from the
  // billing-facing parentName/parentPhone/parentEmail above, which stay
  // untouched as the Accounting side's billing contact. dateOfBirth and
  // photoImage are both optional since a school can create a bare child
  // record from the Accounting side without ever touching the fuller
  // Centre Management profile.
  dateOfBirth    DateTime?
  gender         Gender?
  // Same data: URL pattern as Organization.logoImage -- small, capped,
  // stored directly in the row. Only ever written together with
  // photoConsentGiven=true in the same request (see validation.ts) --
  // the API rejects setting/changing a photo without consent.
  photoImage        String?   @db.Text
  photoConsentGiven  Boolean   @default(false)
  photoConsentAt     DateTime?
  // Set whenever an admin/accountant/manager marks a payment reminder as
  // sent for this child (see /dashboard/reminders) — purely informational,
  // lets whoever's doing month-end reminders see who's already been
  // nudged without re-checking the audit log for each child.
  lastReminderSentAt DateTime?
  archived       Boolean   @default(false)
  // See Category.deletedAt — same soft-trash mechanism, gated the same way
  // by a 2-admin-approved DeletionRequest.
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id])
  planEntries  FinancialPlanEntry[]
  payments     Payment[]
  creditBalance CreditBalance?
  guardians    Guardian[]
  formDocuments FormDocument[]
  parentFormLinks ParentFormLink[]
  attendanceRecords AttendanceRecord[]
  whatsappGroupChecks WhatsAppGroupCheck[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([organizationId, lastName])
  @@map("children")
}

// A child's parent(s) or legal guardian(s), mirroring the paper enrolment
// form -- a child can have more than one (mother, father, other legal
// guardian). Deliberately separate from Child.parentName/parentPhone/
// parentEmail, which remain the single billing contact the Accounting
// side has always used; Guardian is the richer Centre Management profile
// data and is never read by any billing code path.
model Guardian {
  id             String    @id @default(cuid())
  organizationId String
  childId        String
  // Free text ("Mother", "Father", "Grandmother", "Legal guardian", ...)
  // rather than an enum -- family/legal arrangements vary too much for a
  // fixed list.
  relationship   String
  firstName      String
  lastName       String
  // Same "optional, free text, not format-validated" treatment as
  // Child.childIdNumber/parentIdNumber above, and masked the same way by
  // the API by default (see src/lib/idMask.ts) with an audit-logged
  // reveal (AuditLog action "child.idNumber.revealed").
  idNumber       String?
  occupation     String?
  phone          String?
  email          String?
  // Same data: URL pattern as Child.photoImage -- only ever written
  // together with the child's photoConsentGiven=true.
  photoImage     String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([childId])
  @@map("guardians")
}

// A generated form-template PDF for one child, e.g. an Indemnity form
// filled with today's data and handed to a parent to sign on paper
// (Phase 2 Session 3 -- staff-generated only; a parent-facing online
// version that writes structured answers back is Session 4, a separate
// build). Every "Generate" click creates a brand-new row rather than
// overwriting the last one for that childId+formType, per Dylan's
// explicit choice: these documents (especially indemnity, photo/media
// consent, medical/allergy) are dated records of what was generated and
// handed out, not just a "current state" like the photo-consent
// checkbox -- so a school can always show what an earlier version said.
// The PDF itself is stored (not just a data snapshot it's rendered
// from), same reasoning and same data: URL-in-row pattern as
// Organization.logoImage/Child.photoImage: it's the actual document as
// it was generated, immune to the layout changing under it later.
model FormDocument {
  id                String   @id @default(cuid())
  organizationId    String
  childId           String
  formType          FormType
  pdf               String   @db.Text
  generatedAt       DateTime @default(now())
  generatedByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  generatedBy  User?        @relation(fields: [generatedByUserId], references: [id])

  @@index([organizationId])
  @@index([childId, formType])
  @@map("form_documents")
}

// The parent-facing online-form flow (Phase 2 Session 4): staff generates
// a one-time link for a specific child, the parent fills it in on their
// phone (no account needed -- the token itself is the proof, same
// pattern as password-reset/invite links), and it lands as a
// ParentSubmission for staff to review. Nothing here writes to the real
// Child/Guardian records until a staff member explicitly approves it --
// see decision made 2026-09-21: this is deliberately a staging area, not
// a direct write, so a typo or a wrong/bad-faith submission never
// silently overwrites real data.
enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model ParentFormLink {
  id              String    @id @default(cuid())
  organizationId  String
  childId         String
  // Only the SHA-256 hash is stored, same reasoning as
  // PasswordResetToken/InviteToken -- see src/lib/inviteToken.ts, reused
  // here rather than duplicated.
  tokenHash       String    @unique
  createdByUserId String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  // Set the moment a submission comes in, so the link can't be reused --
  // one link, one attempt. A parent who needs to redo it gets a fresh
  // link from staff.
  submittedAt     DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  child        Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("ParentFormLinkCreatedBy", fields: [createdByUserId], references: [id])
  submission   ParentSubmission?

  @@index([organizationId])
  @@index([childId])
  @@map("parent_form_links")
}

model ParentSubmission {
  id               String           @id @default(cuid())
  linkId           String           @unique
  // Denormalized from the link at submission time so this row can be
  // queried/scoped directly (the "Pending reviews" list) without joining
  // through ParentFormLink for every row.
  organizationId   String
  // The parent's answers, as one JSON blob (child fields + a guardians
  // array) validated by parentSubmissionSchema at write time --
  // deliberately not split into real columns since none of it is real
  // until approved; see ParentSubmissionAttachment for the accompanying
  // ID-document photos.
  data             String           @db.Text
  submittedAt      DateTime         @default(now())
  status           SubmissionStatus @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNotes      String?

  link         ParentFormLink               @relation(fields: [linkId], references: [id], onDelete: Cascade)
  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewedBy   User?                        @relation("ParentSubmissionReviewedBy", fields: [reviewedByUserId], references: [id])
  attachments  ParentSubmissionAttachment[]

  @@index([organizationId, status])
  @@map("parent_submissions")
}

model ParentSubmissionAttachment {
  id           String   @id @default(cuid())
  submissionId String
  // "CHILD_ID" or "GUARDIAN_ID" -- which proof field this photo backs,
  // per Dylan's explicit choice (2026-09-21) that attachments back a
  // specific existing ID field rather than being a loose document dump.
  kind         String
  // Human-readable, e.g. "Child's ID document" or "Naledi Kekana's ID
  // document" -- shown as-is on the staff review page.
  label        String
  // Same data: URL-in-row pattern as every other photo field in this
  // app (Child.photoImage, FormDocument.pdf, ...).
  image        String   @db.Text
  uploadedAt   DateTime @default(now())

  submission ParentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("parent_submission_attachments")
}

// Phase 3 Session 1 (Daily running -- attendance, see docs/PLAN.md).
// PRESENT/ABSENT only -- deliberately no Late/Excused in this first pass,
// matching the plan's own wording and "simple beats complete." Add more
// statuses later if a school actually asks.
enum AttendanceStatus {
  PRESENT
  ABSENT
}

// One row per child per calendar day. `date` is stored the same way as
// every other date-only field in this app (Child.enrollmentDate,
// Child.dateOfBirth) -- midnight UTC of the intended calendar day, never
// used as a real timestamp. Deliberately NOT scoped by categoryId here:
// a child's class can change over the year, and "which class was this
// for" is answered by joining Child.categoryId as of now, same as every
// other class-scoped query in this app (children list, admissions,
// enrolled). A TEACHER can only read/write rows for children in their
// own Membership.assignedCategoryId -- enforced in the API route, same
// pattern as MANAGE_CHILDREN.
model AttendanceRecord {
  id             String            @id @default(cuid())
  organizationId String
  childId        String
  date           DateTime
  status         AttendanceStatus
  markedByUserId String
  markedAt       DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  // Set once an absence email has actually been sent for this record, so
  // "Notify absent parents" never double-emails the same parent for the
  // same day if clicked twice (or clicked by two staff members), and so
  // the UI can show "Notified" instead of a live "Notify" action.
  notifiedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  markedBy     User         @relation(fields: [markedByUserId], references: [id])

  @@unique([childId, date])
  @@index([organizationId, date])
  @@map("attendance_records")
}

// Phase 5: a class's fixed weekly timetable (Mon-Fri). The whole week for
// one class is replaced in a single save. Times are "HH:MM" strings in the
// school's local time -- no timezone maths needed for a repeating week.
// Teachers read their own class's timetable; MANAGE_CLASSES edits it.
// "Timetable changed" teacher to-dos come from AuditLog
// (schedule.updated vs schedule.acknowledged), so no extra column here.
model ClassScheduleItem {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String
  dayOfWeek      Int // 1 = Monday ... 5 = Friday (ISO weekday)
  startTime      String // "HH:MM", 24h
  endTime        String? // "HH:MM", 24h
  activity       String
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([categoryId, dayOfWeek])
  @@map("class_schedule_items")
}

// Phase 5 Communication tab: a manual tick that a child's parent has been
// added to their class's WhatsApp group. No WhatsApp integration. Keyed per
// child per class, so a child who moves class shows unticked for the new
// class's group. addedByUserId is a plain column (no relation) on purpose.
model WhatsAppGroupCheck {
  id             String   @id @default(cuid())
  organizationId String
  childId        String
  categoryId     String
  addedAt        DateTime @default(now())
  addedByUserId  String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([childId, categoryId])
  @@index([organizationId])
  @@index([categoryId])
  @@map("whatsapp_group_checks")
}

model PaymentType {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isRecurring    Boolean  @default(false)
  // Used for one-time charges (Registration, Uniform, Trip) generated
  // automatically — e.g. the mandatory Registration charge on enrollment.
  // Recurring types (School Fees) ignore this and use the category's
  // monthlyFeeCents / the child's feeOverrideCents instead.
  defaultAmountCents Int?
  active         Boolean  @default(true)
  // True for the dedicated PaymentType an Event auto-creates for itself
  // (see the Event model) — kept out of the manually-managed Payment Types
  // settings list so admins aren't confused by dozens of one-off event
  // types mixed in with the ones they actually curate, but it still works
  // exactly like any other one-time type for recording/allocating a
  // payment against it.
  isEventType    Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planEntries  FinancialPlanEntry[]
  event        Event?

  @@index([organizationId])
  @@map("payment_types")
}

// A one-time, class-wide charge (e.g. "September Trip — R750") — spec
// section 9. Creating an Event auto-generates a one-time FinancialPlanEntry
// for every active child in the selected category/categories via its own
// dedicated one-time PaymentType (so it reuses the existing payment
// recording/allocation machinery instead of inventing a parallel one). An
// admin can later remove an individual child (deleting their entry) if
// they're not participating — see the events API routes for the rule that
// blocks removing a child who has already paid.
model Event {
  id             String   @id @default(cuid())
  organizationId String
  paymentTypeId  String   @unique
  name           String
  eventDate      DateTime
  amountCents    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentType  PaymentType     @relation(fields: [paymentTypeId], references: [id])
  categories   EventCategory[]

  @@index([organizationId])
  @@map("events")
}

model EventCategory {
  id         String @id @default(cuid())
  eventId    String
  categoryId String

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([eventId, categoryId])
  @@index([categoryId])
  @@map("event_categories")
}

// One row per child, per month/charge, per payment type. Recurring monthly
// fee rows are generated from enrollment/exit dates; one-time rows (events,
// registration) are created directly. Amounts are locked at creation time —
// changing a fee later does not retroactively alter existing rows.
model FinancialPlanEntry {
  id             String          @id @default(cuid())
  organizationId String
  childId        String
  paymentTypeId  String
  year           Int
  month          Int?            // 1-12, null for one-time (event/registration) charges
  description    String
  amountDueCents Int
  amountPaidCents Int            @default(0)
  status         PlanEntryStatus @default(OUTSTANDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  child        Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  paymentType  PaymentType       @relation(fields: [paymentTypeId], references: [id])
  allocations  PaymentAllocation[]

  @@index([organizationId])
  @@index([childId, year, month])
  @@map("financial_plan_entries")
}

model Payment {
  id              String        @id @default(cuid())
  organizationId  String
  childId         String
  amountCents     Int
  method          PaymentMethod
  date            DateTime
  reference       String?
  notes           String?
  recordedByUserId String
  createdAt       DateTime      @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  child        Child               @relation(fields: [childId], references: [id])
  recordedBy   User                @relation("RecordedBy", fields: [recordedByUserId], references: [id])
  allocations  PaymentAllocation[]
  receipt      Receipt?

  @@index([organizationId])
  @@index([childId])
  @@map("payments")
}

model PaymentAllocation {
  id                   String @id @default(cuid())
  paymentId            String
  financialPlanEntryId String
  amountCents          Int

  payment            Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  financialPlanEntry FinancialPlanEntry  @relation(fields: [financialPlanEntryId], references: [id])

  @@index([paymentId])
  @@index([financialPlanEntryId])
  @@map("payment_allocations")
}

model Receipt {
  id            String   @id @default(cuid())
  paymentId     String   @unique
  number        String   @unique // REC-{year}-{6-digit sequence}
  createdAt     DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

model CreditBalance {
  id             String   @id @default(cuid())
  organizationId String
  childId        String   @unique
  amountCents    Int      @default(0)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("credit_balances")
}

// Pending invitations to become a platform admin (owner of the whole SaaS,
// not any one school). Same token-hash-only pattern as Invite — see that
// model's comment — and deliberately its own table rather than reusing
// Invite, since a platform invite has no organizationId at all.
model PlatformInvite {
  id              String       @id @default(cuid())
  email           String
  tokenHash       String       @unique
  status          InviteStatus @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime
  createdAt       DateTime     @default(now())

  @@map("platform_invites")
}

// "Forgot password" flow. Same shape/security model as PlatformInvite's
// token: only the SHA-256 hash is stored, the raw token lives only in the
// emailed link and is never persisted, and it's single-use + short-lived
// (usedAt set, or expiresAt passed, both make it dead). Deliberately not a
// column on User (a user could in theory have more than one outstanding
// request; each one gets its own row and old ones don't need cleanup logic
// beyond "the where clause ignores them").
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Append-only trail: who did what, when. Required both for the "Frank
// viewed records" activity feed the product spec asks for, and for being
// able to answer "who accessed/changed this record" if a customer or
// regulator ever asks after an incident.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String   // e.g. "payment.created", "child.archived", "statement.viewed"
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// A category or child record can only be permanently removed through this
// two-person approval flow — no single person (not even one admin acting
// alone) can delete either kind of record. Once REQUIRED_APPROVALS
// (src/lib/deletion.ts) distinct admins have each recorded a
// DeletionApproval, the target's `deletedAt` is set and it drops out of
// every normal view (Settings → Trash lists it, restorable, until purged
// 30 days later).
model DeletionRequest {
  id                String                 @id @default(cuid())
  organizationId    String
  targetType        DeletionTargetType
  targetId          String
  // Snapshot of the target's display name at request time, so the
  // approval queue and trash list still read sensibly even though the
  // underlying row may itself be gone by the time someone looks.
  targetLabel       String
  // Why this deletion was requested — mandatory going forward (enforced by
  // deletionRequestSchema in validation.ts), never optional. The default
  // "" only exists so this column can be added to the live table without a
  // destructive migration; every request created after this field shipped
  // always has a real, non-empty reason.
  reason            String                 @default("") @db.Text
  status            DeletionRequestStatus  @default(PENDING)
  requestedByUserId String
  createdAt         DateTime               @default(now())
  resolvedAt        DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvals    DeletionApproval[]

  @@index([organizationId, status])
  @@index([targetType, targetId])
  @@map("deletion_requests")
}

// One row per admin who has approved a given request. The unique
// constraint is what actually prevents one admin's approval from being
// (accidentally or otherwise) counted twice.
model DeletionApproval {
  id                String   @id @default(cuid())
  deletionRequestId String
  userId            String
  createdAt         DateTime @default(now())

  deletionRequest DeletionRequest @relation(fields: [deletionRequestId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deletionRequestId, userId])
  @@map("deletion_approvals")
}

// "Send all reminders" — the same request → 2-people-approve → execute
// shape as DeletionRequest/DeletionApproval above, but for a different
// action (emailing every parent with an outstanding balance) and a
// different approval pool: any 2 *distinct* ADMIN or ACCOUNTANT people
// (any combination, "director" already maps to ADMIN elsewhere in this
// app) — never a Viewer — per the org owner's own spec. Reuses
// DeletionRequestStatus since the three states (PENDING/APPROVED/
// CANCELLED) mean exactly the same thing here.
model ReminderSendRequest {
  id                String                @id @default(cuid())
  organizationId    String
  status            DeletionRequestStatus @default(PENDING)
  requestedByUserId String
  // How many reminders were outstanding at request time — shown in the
  // approval queue so an approver knows roughly what they're approving
  // without needing to separately open the Reminders page first. The
  // actual send recomputes the live list at execution time rather than
  // trusting this snapshot, since it could be stale by the time the 2nd
  // approval lands.
  reminderCountAtRequest Int
  createdAt         DateTime              @default(now())
  resolvedAt        DateTime?

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvals    ReminderSendApproval[]

  @@index([organizationId, status])
  @@map("reminder_send_requests")
}

model ReminderSendApproval {
  id                     String   @id @default(cuid())
  reminderSendRequestId  String
  userId                 String
  createdAt              DateTime @default(now())

  reminderSendRequest ReminderSendRequest @relation(fields: [reminderSendRequestId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reminderSendRequestId, userId])
  @@map("reminder_send_approvals")
}

// Public marketing-site testimonials. Deliberately standalone — not tied
// to an Organization/User — since anyone (a parent, a school director, a
// prospective customer who just wants to say something) can submit one
// without an account. Nothing here shows on the homepage until a platform
// admin (dylanmaps3@gmail.com today, via PLATFORM_ADMIN_EMAILS — see
// src/lib/platformAdmin.ts) approves it: see CRECHELY_AUDIT.md's rule
// against ever inventing or auto-publishing proof.
enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

model Testimonial {
  id           String             @id @default(cuid())
  authorName   String
  schoolName   String?
  quote        String
  status       TestimonialStatus  @default(PENDING)
  createdAt    DateTime           @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  reviewedBy User? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("testimonials")
}
